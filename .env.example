# Site public et CMS WordPress headless
SITE_URL=https://ibescbusiness.samatech.cloud
WP_API_URL=https://ibesc.samatech.cloud/wp-json/wp/v2
ALLOW_INDEXING=0

# Stockage privé persistant des demandes et documents.
# À définir selon le répertoire persistant fourni par l'hébergement.
DATA_DIR=/data

# Espace équipe
ADMIN_PASSWORD=

# E-mails transactionnels
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_REPLY_TO=info@ibescbusiness.com
